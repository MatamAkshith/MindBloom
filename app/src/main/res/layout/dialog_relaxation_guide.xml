<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Row: Icon & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGuideIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🌬️"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvGuideTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Deep Breathing"
                android:textColor="@color/primary_sage_dark"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Duration Badge -->
        <TextView
            android:id="@+id/tvGuideDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_banner"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="⏱️ 3 mins • Beginner Friendly"
            android:textColor="@color/primary_sage_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Purpose / Summary -->
        <TextView
            android:id="@+id/tvGuideSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Summary description of the activity."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/card_stroke" />

        <!-- Step-by-Step Instructions Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step-by-Step Instructions:"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Full Instructions -->
        <TextView
            android:id="@+id/tvGuideInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:text="Instructions text goes here..."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Gentle Non-Medical Tip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner"
            android:padding="10dp"
            android:text="🌱 Tip: Practice gently without straining. Stop anytime if you feel uncomfortable."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
